{
  "name": "@sabaki/deadstones",
  "version": "2.2.0",
  "description": "Simple Monte Carlo functions to determine dead stones on a Go board.",
  "main": "./js/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SabakiHQ/deadstones.git"
  },
  "keywords": [
    "go",
    "weiqi",
    "baduk",
    "strategy",
    "analyzer",
    "boardgame",
    "montecarlo"
  ],
  "author": "Yichuan Shen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SabakiHQ/deadstones/issues"
  },
  "homepage": "https://github.com/SabakiHQ/deadstones",
  "exports": {
    ".": {
      "import": "./js/main.mjs",
      "require": "./js/main.js"
    },
    "./wasm/deadstones_bg.wasm": "./wasm/deadstones_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "js",
    "wasm/deadstones_bg.wasm"
  ],
  "scripts": {
    "build": "wasm-pack build --out-dir ./wasm --target nodejs",
    "prepublishOnly": "npm run build",
    "test": "for f in tests/*.test.js; do echo \"== $f ==\"; node \"$f\" || exit 1; done"
  },
  "devDependencies": {
    "tap": "^14.6.1"
  }
}
